# Copy to .env and fill in. .env is git-ignored; never paste these values into a chat.

# Supabase (Project Settings -> API / Database on supabase.com)
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side only. Bypasses RLS: the backend uses it, the browser never sees it.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Session pooler, port 5432) used by the backend and migrations
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Read-only source for the one-time legacy import (never written to)
PZ_LEGACY_DATA=C:\Users\MohamedKaram\Desktop\project-zero-data

# Model providers (review 029a). Paid model calls are OFF unless PZ_AI_PAID is exactly "on" AND the provider's key is
# set. Turning them on is Mohamed's decision; without them every feature uses its no-model path (e.g. the rules cards).
# xAI is not used by the rewrite.
DEEPINFRA_API_KEY=
PZ_AI_PAID=off

# Server
PZ_HOST=127.0.0.1
PZ_PORT=8177
